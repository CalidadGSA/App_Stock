{
  "name": "gestionstock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:api": "node src/main.js",
    "sync:now": "node -e \"require('./src/load-env'); require('./src/jobs/obrasSocialesSync.job').runLegacySyncBatch().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "sync:operadores-medicamentos": "node -e \"require('./src/load-env'); require('./src/jobs/obrasSocialesSync.job').runOperadoresMedicamentosSyncBatch().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "cron:legacy": "node src/jobs/obrasSocialesSync.runner.js",
    "inventario:cierre": "node --import tsx scripts/run-inventario-cierre-once.cjs",
    "cron:diagnose": "node scripts/diagnose-legacy-cron.cjs",
    "devolver:masivo": "node --import tsx scripts/devolver-para-devolver-todas-sucursales.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "mssql": "^7.2.0",
    "mysql2": "^3.19.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
